SAAS;CACrC,MAAM,cAAc,iBAAiB;CAErC,OACE,kDAAC,QAAD;EAAM,WAAW,OAAO;YAAxB;GACE,kDAAC,OAAD;IAAK,WAAW,uCAAa,OAAO,QAAQ,WAAW,UAAU;cAAjE,CACE,qDAAC,+BAAD;KAAQ,IAAG;KAAK,WAAW,WAAW;eAAO;IAErC;;;;cACR,qDAAC,6BAAD;KAAM,WAAW,WAAW;eAAU;IAAuD;;;;YAC1F;;;;;;GAEJ,CAAC,iBAAiB,qDAAC,gCAAD,CAAmB;;;;;GAEtC,kDAAC,OAAD;IAAK,WAAW,OAAO;cAAvB;KACG,eACC,qDAAC,gCAAD;MACU;MACE;MACE;MACD;MACL;MACC;MACP,gBAAgB,QAAQ;MACxB,kBAAkB,QAAQ;MAC1B,mBAAmB,QAAQ;MAC3B,cAAc,QAAQ;MACtB,eAAe,QAAQ;KACxB;;;;;KAGF,KAAK,UACJ,qDAAC,mCAAD;MAAY,QAAO;gBAAnB,CACE,qDAAC,uCAAD,YAAgB,6DAA0E;;;;gBAC1F,qDAAC,0CAAD,YACE,qDAAC,+BAAD;OAAQ,SAAS,KAAK;iBAAO;MAAkB;;;;eAC9B;;;;cACT;;;;;;KAGb,CAAC,KAAK,UAAU,CAAC,KAAK,UAAU,qDAAC,gCAAD;MAAS,WAAW,WAAW;MAAS,OAAM;KAAuB;;;;;KAErG,gBACC,qDAAC,gCAAD;MACE,MAAM,qDAAC,qCAAD,CAAe;;;;;MACrB,OAAM;MACN,aAAY;KACb;;;;;KAGF,aACC,qDAAC,gCAAD;MACE,MAAM,qDAAC,4CAAD,CAAsB;;;;;MAC5B,OAAM;MACN,aAAY;gBAEZ,qDAAC,+BAAD;OAAQ,SAAS,QAAQ;iBAAc;MAAuB;;;;;KACpD;;;;;KAGb,YACC,oGACE,kDAAC,MAAD;MACE,WAAW,uCAAa,OAAO,MAAM,KAAK,cAAc,OAAO,UAAU;MACzE,cAAW;MACX,aAAW,KAAK,cAAc,KAAK;gBAElC,KAAK,MAAM,KAAK,SAAS,UACxB,kDAAC,MAAD;OAEE,WAAW,OAAO;OAClB,OAAO,EAAE,gBAAgB,GAAI,QAAQ,YAAa,sBAAsB,IAAI;iBAE5E,qDAAC,gCAAD;QACW;QACT,cAAc,cAAc,IAAI,QAAQ,WAAW;QACnD,UAAU,UAAU,IAAI,QAAQ,EAAE;QAClC,eAAe;QACf,kBAAkB;OACnB;;;;;MACC,GAXG,QAAQ;;;;aAWX,CACL;KACC;;;;eAEJ,kDAAC,OAAD;MAAK,WAAW,OAAO;gBAAvB;OACG,KAAK,eAAe,qDAAC,gCAAD,EAAS,OAAM,0BAA2B;;;;;OAE9D,KAAK,cACJ,qDAAC,mCAAD;QAAY,QAAO;kBAAnB,CACE,qDAAC,uCAAD,YAAgB,6DAA0E;;;;kBAC1F,qDAAC,0CAAD,YACE,qDAAC,+BAAD;SAAQ,SAAS,KAAK;mBAAO;QAAkB;;;;iBAC9B;;;;gBACT;;;;;;OAGb,KAAK,WAAW,CAAC,KAAK,eAAe,CAAC,KAAK,cAC1C,qDAAC,+BAAD;QAAQ,YAAW;QAAS,MAAM,qDAAC,2CAAD,CAAqB;;;;;QAAG,SAAS,KAAK;kBAAU;OAE1E;;;;;OAGT,CAAC,KAAK,WAAW,KAAK,UAAU,CAAC,KAAK,cACrC,qDAAC,6BAAD;QAAM,WAAW,OAAO;kBAAxB,CACE,qDAAC,iDAAD,EAA0B,WAAW,OAAO,QAAU;;;;kBAAC,+BAEnD;;;;;;OAIR,kDAAC,OAAD;QAAK,KAAK;QAAQ,eAAY;OAAQ;;;;;MACnC;;;;;aACL;;;;;IAED;;;;;;EACD;;;;;;AAEV","names":[],"ignoreList":[],"sources":["ProductsPage.jsx"],"sourcesContent":["import { useEffect, useRef, useState } from 'react'\r\nimport {\r\n  Button,\r\n  MessageBar,\r\n  MessageBarActions,\r\n  MessageBarBody,\r\n  Spinner,\r\n  Text,\r\n  Title1,\r\n  makeStyles,\r\n  mergeClasses,\r\n  tokens,\r\n} from '@fluentui/react-components'\r\nimport { ArrowDown20Regular, Box24Regular, CheckmarkCircle20Regular, SearchInfo24Regular } from '@fluentui/react-icons'\r\nimport { addWishlistItem, getWishlist, removeWishlistItem } from '../api/wishlist'\r\nimport EmptyState from '../components/EmptyState'\r\nimport { usePageStyles } from '../components/pageStyles'\r\nimport CatalogFilters from '../features/catalog/CatalogFilters'\r\nimport FeaturedProducts from '../features/catalog/FeaturedProducts'\r\nimport ProductCard from '../features/catalog/ProductCard'\r\nimport { useCatalogFeed } from '../features/catalog/useCatalogFeed'\r\nimport { useCatalogFilters } from '../features/catalog/useCatalogFilters'\r\nimport { useCategories } from '../hooks/useCategories'\r\nimport { useOnReachEnd } from '../hooks/useOnReachEnd'\r\n\r\nconst PAGE_SIZE = 10\r\nconst ENTRADA_ESCALONADA_MS = 60\r\n\r\nconst useStyles = makeStyles({\r\n  // La página ocupa el ancho (la selección de los mejores, también); el resto del contenido va en una columna.\r\n  main: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalXL,\r\n    width: '100%',\r\n    boxSizing: 'border-box',\r\n    paddingTop: tokens.spacingVerticalXL,\r\n    paddingBottom: tokens.spacingVerticalXXXL,\r\n  },\r\n  column: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalXL,\r\n    width: '100%',\r\n    maxWidth: '860px',\r\n    boxSizing: 'border-box',\r\n    margin: '0 auto',\r\n    padding: `0 ${tokens.spacingHorizontalL}`,\r\n  },\r\n  // Las tarjetas se colocan siempre de dos en dos, también en pantallas estrechas.\r\n  grid: {\r\n    display: 'grid',\r\n    gridTemplateColumns: 'repeat(2, minmax(0, 1fr))',\r\n    gap: tokens.spacingHorizontalL,\r\n    margin: 0,\r\n    padding: 0,\r\n    listStyleType: 'none',\r\n    transitionProperty: 'opacity',\r\n    transitionDuration: tokens.durationNormal,\r\n  },\r\n  refreshing: {\r\n    opacity: 0.55,\r\n  },\r\n  // Cada tarjeta entra subiendo y apareciendo, una detrás de otra dentro de cada tanda de diez.\r\n  entry: {\r\n    animationName: {\r\n      from: { opacity: 0, transform: 'translateY(16px)' },\r\n      to: { opacity: 1, transform: 'translateY(0)' },\r\n    },\r\n    animationDuration: tokens.durationSlow,\r\n    animationTimingFunction: tokens.curveDecelerateMid,\r\n    animationFillMode: 'both',\r\n    '@media (prefers-reduced-motion: reduce)': {\r\n      animationName: 'none',\r\n    },\r\n  },\r\n  footer: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingVerticalM,\r\n    minHeight: '64px',\r\n  },\r\n  end: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingHorizontalS,\r\n    color: tokens.colorNeutralForeground3,\r\n  },\r\n  endIcon: {\r\n    color: tokens.colorPaletteGreenForeground1,\r\n  },\r\n})\r\n\r\n// Vista de productos: lo primero que ve el cliente al iniciar sesión (HU7). Arriba, los mejor valorados; debajo, los\r\n// productos de diez en diez, que se cargan solos al llegar al final de la página.\r\nexport default function ProductsPage() {\r\n  const pageStyles = usePageStyles()\r\n  const styles = useStyles()\r\n  const { categories } = useCategories()\r\n  const filters = useCatalogFilters()\r\n  const { search, category, minRating, sort, order, debouncedSearch, filtersActive } = filters\r\n  const feed = useCatalogFeed({\r\n    search: debouncedSearch,\r\n    category,\r\n    minRating,\r\n    sort,\r\n    order,\r\n    size: PAGE_SIZE,\r\n  })\r\n  const endRef = useOnReachEnd(feed.loadMore, feed.hasMore && !feed.loadingMore && !feed.failedMore)\r\n  const categoryNames = new Map(categories.map(({ id, nombre }) => [id, nombre]))\r\n  // Productos que el cliente tiene en favoritos (HU14): se leen al entrar y, después, cada cambio responde con la lista\r\n  // completa. Si la lista no se puede leer, el catálogo funciona igual con los corazones vacíos. `cambiados` evita que\r\n  // una lectura lenta pise un cambio que el cliente ya ha hecho.\r\n  const [favoritos, setFavoritos] = useState(() => new Set())\r\n  const cambiados = useRef(false)\r\n  const aFavoritos = (lista) => new Set(lista.items.map((item) => item.productoId))\r\n\r\n  useEffect(() => {\r\n    let cancelled = false\r\n    getWishlist()\r\n      .then((lista) => {\r\n        if (!cancelled && !cambiados.current) setFavoritos(aFavoritos(lista))\r\n      })\r\n      .catch(() => { })\r\n    return () => {\r\n      cancelled = true\r\n    }\r\n  }, [])\r\n\r\n  const anadirFavorito = async (productId) => {\r\n    const lista = await addWishlistItem(productId)\r\n    cambiados.current = true\r\n    setFavoritos(aFavoritos(lista))\r\n  }\r\n\r\n  const quitarFavorito = async (productId) => {\r\n    const lista = await removeWishlistItem(productId)\r\n    cambiados.current = true\r\n    setFavoritos(aFavoritos(lista))\r\n  }\r\n  // Sin ningún filtro, que no haya productos significa que el catálogo está vacío; con filtros, que no coinciden.\r\n  const catalogEmpty = feed.loaded && feed.totalItems === 0 && !debouncedSearch && !category && !minRating\r\n  const noMatches = feed.loaded && feed.totalItems === 0 && !catalogEmpty\r\n  const hasItems = feed.items.length > 0\r\n  const showFilters = filtersActive || hasItems\r\n\r\n  return (\r\n    <main className={styles.main}>\r\n      <div className={mergeClasses(styles.column, pageStyles.titleBlock)}>\r\n        <Title1 as=\"h1\" className={pageStyles.title}>\r\n          Productos\r\n        </Title1>\r\n        <Text className={pageStyles.subtitle}>Descubre lo que ofrecen los vendedores de ESIBuy.</Text>\r\n      </div>\r\n\r\n      {!filtersActive && <FeaturedProducts />}\r\n\r\n      <div className={styles.column}>\r\n        {showFilters && (\r\n          <CatalogFilters\r\n            search={search}\r\n            category={category}\r\n            categories={categories}\r\n            minRating={minRating}\r\n            sort={sort}\r\n            order={order}\r\n            onSearchChange={filters.changeSearch}\r\n            onCategoryChange={filters.changeCategory}\r\n            onMinRatingChange={filters.changeMinRating}\r\n            onSortChange={filters.changeSort}\r\n            onOrderChange={filters.changeOrder}\r\n          />\r\n        )}\r\n\r\n        {feed.failed && (\r\n          <MessageBar intent=\"error\">\r\n            <MessageBarBody>No se han podido cargar los productos. Inténtalo de nuevo.</MessageBarBody>\r\n            <MessageBarActions>\r\n              <Button onClick={feed.retry}>Reintentar</Button>\r\n            </MessageBarActions>\r\n          </MessageBar>\r\n        )}\r\n\r\n        {!feed.loaded && !feed.failed && <Spinner className={pageStyles.loading} label=\"Cargando productos…\" />}\r\n\r\n        {catalogEmpty && (\r\n          <EmptyState\r\n            icon={<Box24Regular />}\r\n            title=\"Todavía no hay productos\"\r\n            description=\"Cuando los vendedores publiquen sus productos, los verás aquí.\"\r\n          />\r\n        )}\r\n\r\n        {noMatches && (\r\n          <EmptyState\r\n            icon={<SearchInfo24Regular />}\r\n            title=\"No hay productos que coincidan con los filtros\"\r\n            description=\"Prueba con otro nombre, otra categoría u otra valoración.\"\r\n          >\r\n            <Button onClick={filters.clearFilters}>Limpiar filtros</Button>\r\n          </EmptyState>\r\n        )}\r\n\r\n        {hasItems && (\r\n          <>\r\n            <ul\r\n              className={mergeClasses(styles.grid, feed.refreshing && styles.refreshing)}\r\n              aria-label=\"Productos\"\r\n              aria-busy={feed.refreshing || feed.loadingMore}\r\n            >\r\n              {feed.items.map((product, index) => (\r\n                <li\r\n                  key={product.id}\r\n                  className={styles.entry}\r\n                  style={{ animationDelay: `${(index % PAGE_SIZE) * ENTRADA_ESCALONADA_MS}ms` }}\r\n                >\r\n                  <ProductCard\r\n                    product={product}\r\n                    categoryName={categoryNames.get(product.categoriaId)}\r\n                    favorite={favoritos.has(product.id)}\r\n                    onAddFavorite={anadirFavorito}\r\n                    onRemoveFavorite={quitarFavorito}\r\n                  />\r\n                </li>\r\n              ))}\r\n            </ul>\r\n\r\n            <div className={styles.footer}>\r\n              {feed.loadingMore && <Spinner label=\"Cargando más productos…\" />}\r\n\r\n              {feed.failedMore && (\r\n                <MessageBar intent=\"error\">\r\n                  <MessageBarBody>No se han podido cargar más productos. Inténtalo de nuevo.</MessageBarBody>\r\n                  <MessageBarActions>\r\n                    <Button onClick={feed.retry}>Reintentar</Button>\r\n                  </MessageBarActions>\r\n                </MessageBar>\r\n              )}\r\n\r\n              {feed.hasMore && !feed.loadingMore && !feed.failedMore && (\r\n                <Button appearance=\"subtle\" icon={<ArrowDown20Regular />} onClick={feed.loadMore}>\r\n                  Ver más productos\r\n                </Button>\r\n              )}\r\n\r\n              {!feed.hasMore && feed.loaded && !feed.refreshing && (\r\n                <Text className={styles.end}>\r\n                  <CheckmarkCircle20Regular className={styles.endIcon} />\r\n                  Has visto todos los productos\r\n                </Text>\r\n              )}\r\n\r\n              {/* Cuando esta marca llega a la vista (o casi), se cargan los diez siguientes. */}\r\n              <div ref={endRef} aria-hidden=\"true\" />\r\n            </div>\r\n          </>\r\n        )}\r\n      </div>\r\n    </main>\r\n  )\r\n}\r\n"],"file":"/frontend/src/pages/ProductsPage.jsx"}