AAM;EACpB,YAAY,8BAAU,OAAO;EAC7B,QAAQ,8BAAU,OAAO;EACzB,QAAQ,8BAAU;EAClB,aAAa,8BAAU,OAAO;EAC9B,OAAO,8BAAU,OAAO;EACxB,YAAY,8BAAU,KAAK;EAC3B,SAAS,8BAAU,OAAO;CAC5B,CAAC,CAAC,CAAC;CACH,UAAU,8BAAU,KAAK;CACzB,UAAU,8BAAU,KAAK;AAC3B;;;;AAKe,SAAS,eAAe;CACrC,MAAM,aAAa,yCAAc;CACjC,MAAM,SAAS,UAAU;CACzB,MAAM,UAAU,4CAAkB,uCAAY,EAAG,CAAC,CAAC;CACnD,MAAM,EAAE,MAAM,SAAS,QAAQ,UAAU,sCAAY,OAAO;CAC5D,MAAM,CAAC,aAAa,kBAAkB,mCAAS,IAAI;CACnD,MAAM,CAAC,UAAU,eAAe,mCAAS,IAAI;CAC7C,MAAM,CAAC,OAAO,YAAY,mCAAS,IAAI;CACvC,MAAM,QAAQ,eAAe;CAE7B,MAAM,SAAS,OAAO,SAAS;EAC7B,SAAS,IAAI;EACb,YAAY,KAAK,UAAU;EAC3B,IAAI;GACF,eAAe,MAAM,6CAAmB,KAAK,UAAU,CAAC;GACxD,SAAS;IAAE,QAAQ;IAAW,OAAO,GAAG,KAAK,OAAO;GAAkC,CAAC;EACzF,QAAQ;GACN,SAAS;IAAE,QAAQ;IAAS,OAAO,0BAA0B,KAAK,OAAO;GAAwC,CAAC;EACpH,UAAU;GACR,YAAY,IAAI;EAClB;CACF;CAEA,OACE,kDAAC,QAAD;EAAM,WAAW,WAAW;YAA5B;GACE,kDAAC,OAAD;IAAK,WAAW,WAAW;cACzB,kDAAC,OAAD;KAAK,WAAW,WAAW;eAA3B,CACE,qDAAC,+BAAD;MAAQ,IAAG;MAAK,WAAW,WAAW;gBAAO;KAErC;;;;eACR,qDAAC,6BAAD;MAAM,WAAW,WAAW;gBAAU;KAAuD;;;;aAC1F;;;;;;GACF;;;;;GACJ,SACC,qDAAC,mCAAD;IAAY,QAAQ,MAAM;cACxB,qDAAC,uCAAD,YAAiB,MAAM,MAAsB;;;;;GACnC;;;;;GAEb,UACC,qDAAC,mCAAD;IAAY,QAAO;cAAnB,CACE,qDAAC,uCAAD,YAAgB,6DAA0E;;;;cAC1F,qDAAC,0CAAD,YACE,qDAAC,+BAAD;KAAQ,SAAS;eAAO;IAAkB;;;;aACzB;;;;YACT;;;;;;GAEb,CAAC,SAAS,CAAC,UAAU,qDAAC,gCAAD;IAAS,OAAM;IAA0B,WAAW,WAAW;GAAU;;;;;GAC9F,OAAO,MAAM,WAAW,KACvB,qDAAC,gCAAD;IACE,MAAM,qDAAC,uCAAD,CAAiB;;;;;IACvB,OAAM;IACN,aAAY;cAEZ,qDAAC,gCAAD;KAAY,IAAI,6BAAM;KAAU,YAAW;eAAU;IAEzC;;;;;GACF;;;;;GAEb,OAAO,MAAM,SAAS,KACrB,kDAAC,MAAD;IAAI,cAAW;IAAgB,WAAW,OAAO;cAC9C,MAAM,MAAM,KAAK,SAChB,kDAAC,MAAD,YACE,kDAAC,cAAD;KAAoB;KAAM,UAAU,aAAa,KAAK;KAAY,UAAU;IAAS;;;;aACnF,GAFK,KAAK;;;;WAEV,CACL;GACC;;;;;EAEF;;;;;;AAEV","names":[],"ignoreList":[],"sources":["WishlistPage.jsx"],"sourcesContent":["import PropTypes from 'prop-types'\r\nimport { useCallback, useState } from 'react'\r\nimport {\r\n  Badge,\r\n  Button,\r\n  Card,\r\n  MessageBar,\r\n  MessageBarActions,\r\n  MessageBarBody,\r\n  Spinner,\r\n  Text,\r\n  Title1,\r\n  makeStyles,\r\n  mergeClasses,\r\n  tokens,\r\n} from '@fluentui/react-components'\r\nimport { Delete20Regular, Heart24Regular } from '@fluentui/react-icons'\r\nimport { Link } from 'react-router-dom'\r\nimport { getWishlist, removeWishlistItem } from '../api/wishlist'\r\nimport EmptyState from '../components/EmptyState'\r\nimport LinkButton from '../components/LinkButton'\r\nimport { usePageStyles } from '../components/pageStyles'\r\nimport { useApiQuery } from '../hooks/useApiQuery'\r\nimport { PATHS, getProductDetailPath } from '../routes/paths'\r\nimport { formatDate, formatPrice } from '../utils/format'\r\n\r\nconst useStyles = makeStyles({\r\n  list: {\r\n    listStyle: 'none',\r\n    margin: 0,\r\n    padding: 0,\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalM,\r\n  },\r\n  // En pantallas estrechas el precio baja a una segunda línea\r\n  item: {\r\n    display: 'flex',\r\n    flexDirection: 'row',\r\n    flexWrap: 'wrap',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingHorizontalL,\r\n  },\r\n  // Un producto que ya no está disponible se ve atenuado: sigue en la lista, pero no se puede comprar\r\n  unavailable: {\r\n    opacity: 0.6,\r\n  },\r\n  media: {\r\n    flexShrink: 0,\r\n    width: '72px',\r\n    height: '72px',\r\n    overflow: 'hidden',\r\n    borderRadius: tokens.borderRadiusMedium,\r\n    backgroundColor: tokens.colorNeutralBackground3,\r\n  },\r\n  image: {\r\n    display: 'block',\r\n    width: '100%',\r\n    height: '100%',\r\n    objectFit: 'cover',\r\n  },\r\n  placeholder: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n    width: '100%',\r\n    height: '100%',\r\n    color: tokens.colorNeutralForeground4,\r\n  },\r\n  placeholderImage: {\r\n    width: '24px',\r\n    height: '24px',\r\n    objectFit: 'contain',\r\n  },\r\n  text: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    alignItems: 'flex-start',\r\n    gap: tokens.spacingVerticalXXS,\r\n    flexGrow: 1,\r\n    minWidth: 0,\r\n  },\r\n  name: {\r\n    fontWeight: tokens.fontWeightSemibold,\r\n    color: tokens.colorBrandForeground1,\r\n    overflowWrap: 'anywhere',\r\n  },\r\n  muted: {\r\n    color: tokens.colorNeutralForeground3,\r\n  },\r\n  summary: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingHorizontalM,\r\n    marginLeft: 'auto',\r\n  },\r\n})\r\n\r\n// Cómo se puede comprar ahora un favorito: un producto desactivado sigue en la lista, pero ya no se abre su detalle.\r\nfunction availabilityBadge(item) {\r\n  if (!item.disponible) return <Badge appearance=\"tint\" color=\"informative\">No disponible</Badge>\r\n  if (item.stock <= 0) return <Badge appearance=\"tint\" color=\"warning\">Agotado</Badge>\r\n  return null\r\n}\r\n\r\nfunction WishlistItem({ item, removing, onRemove }) {\r\n  const styles = useStyles()\r\n\r\n  return (\r\n    <Card className={mergeClasses(styles.item, !item.disponible && styles.unavailable)}>\r\n      <div className={styles.media}>\r\n        {item.imagen ? (\r\n          <img className={styles.image} src={item.imagen} alt={item.nombre} loading=\"lazy\" />\r\n        ) : (\r\n          <span className={styles.placeholder}>\r\n            <img\r\n              className={styles.placeholderImage}\r\n              src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M3 3l18 18M10 12l-4 6h12l-3-4-2 2M6 6h11a2 2 0 0 1 2 2v8' fill='none' stroke='%23999999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E\"\r\n              alt=\"Sin imagen\"\r\n            />\r\n          </span>\r\n        )}\r\n      </div>\r\n      <div className={styles.text}>\r\n        {item.disponible ? (\r\n          <Link to={getProductDetailPath(item.productoId)} className={styles.name}>\r\n            {item.nombre}\r\n          </Link>\r\n        ) : (\r\n          <Text className={styles.name}>{item.nombre}</Text>\r\n        )}\r\n        <Text size={200} className={styles.muted}>\r\n          Añadido el {formatDate(item.addedAt)}\r\n        </Text>\r\n        {availabilityBadge(item)}\r\n      </div>\r\n      <div className={styles.summary}>\r\n        <Text weight=\"semibold\">{formatPrice(item.precioFinal)}</Text>\r\n        <Button\r\n          appearance=\"subtle\"\r\n          icon={<Delete20Regular />}\r\n          aria-label={`Quitar ${item.nombre} de favoritos`}\r\n          title=\"Quitar de favoritos\"\r\n          disabled={removing}\r\n          onClick={() => onRemove(item)}\r\n        />\r\n      </div>\r\n    </Card>\r\n  )\r\n}\r\n\r\nWishlistItem.propTypes = {\r\n  item: PropTypes.shape({\r\n    productoId: PropTypes.string.isRequired,\r\n    nombre: PropTypes.string.isRequired,\r\n    imagen: PropTypes.string,\r\n    precioFinal: PropTypes.number.isRequired,\r\n    stock: PropTypes.number.isRequired,\r\n    disponible: PropTypes.bool.isRequired,\r\n    addedAt: PropTypes.string.isRequired,\r\n  }).isRequired,\r\n  removing: PropTypes.bool.isRequired,\r\n  onRemove: PropTypes.func.isRequired,\r\n}\r\n\r\n// «Mis favoritos» del cliente (HU14): su lista de deseos, en el orden en que añadió cada producto y con los datos\r\n// actuales de cada uno (precio, si está agotado o si el vendedor lo ha desactivado). Cada uno se puede quitar sin\r\n// confirmación, porque se puede volver a añadir desde el catálogo; el backend responde con la lista actualizada.\r\nexport default function WishlistPage() {\r\n  const pageStyles = usePageStyles()\r\n  const styles = useStyles()\r\n  const fetcher = useCallback(() => getWishlist(), [])\r\n  const { data: cargada, failed, retry } = useApiQuery(fetcher)\r\n  const [actualizada, setActualizada] = useState(null)\r\n  const [quitando, setQuitando] = useState(null)\r\n  const [aviso, setAviso] = useState(null)\r\n  const lista = actualizada ?? cargada\r\n\r\n  const quitar = async (item) => {\r\n    setAviso(null)\r\n    setQuitando(item.productoId)\r\n    try {\r\n      setActualizada(await removeWishlistItem(item.productoId))\r\n      setAviso({ intent: 'success', texto: `${item.nombre} se ha quitado de tus favoritos.` })\r\n    } catch {\r\n      setAviso({ intent: 'error', texto: `No se ha podido quitar ${item.nombre} de tus favoritos. Inténtalo de nuevo.` })\r\n    } finally {\r\n      setQuitando(null)\r\n    }\r\n  }\r\n\r\n  return (\r\n    <main className={pageStyles.page}>\r\n      <div className={pageStyles.heading}>\r\n        <div className={pageStyles.titleBlock}>\r\n          <Title1 as=\"h1\" className={pageStyles.title}>\r\n            Mis favoritos\r\n          </Title1>\r\n          <Text className={pageStyles.subtitle}>Los productos que has guardado para más adelante.</Text>\r\n        </div>\r\n      </div>\r\n      {aviso && (\r\n        <MessageBar intent={aviso.intent}>\r\n          <MessageBarBody>{aviso.texto}</MessageBarBody>\r\n        </MessageBar>\r\n      )}\r\n      {failed && (\r\n        <MessageBar intent=\"error\">\r\n          <MessageBarBody>No se han podido cargar tus favoritos. Inténtalo de nuevo.</MessageBarBody>\r\n          <MessageBarActions>\r\n            <Button onClick={retry}>Reintentar</Button>\r\n          </MessageBarActions>\r\n        </MessageBar>\r\n      )}\r\n      {!lista && !failed && <Spinner label=\"Cargando tus favoritos…\" className={pageStyles.loading} />}\r\n      {lista?.items.length === 0 && (\r\n        <EmptyState\r\n          icon={<Heart24Regular />}\r\n          title=\"Aún no tienes favoritos\"\r\n          description=\"Pulsa el corazón de un producto del catálogo para guardarlo aquí.\"\r\n        >\r\n          <LinkButton to={PATHS.PRODUCTS} appearance=\"primary\">\r\n            Ver los productos\r\n          </LinkButton>\r\n        </EmptyState>\r\n      )}\r\n      {lista?.items.length > 0 && (\r\n        <ul aria-label=\"Tus favoritos\" className={styles.list}>\r\n          {lista.items.map((item) => (\r\n            <li key={item.productoId}>\r\n              <WishlistItem item={item} removing={quitando === item.productoId} onRemove={quitar} />\r\n            </li>\r\n          ))}\r\n        </ul>\r\n      )}\r\n    </main>\r\n  )\r\n}\r\n"],"file":"/frontend/src/pages/WishlistPage.jsx"}