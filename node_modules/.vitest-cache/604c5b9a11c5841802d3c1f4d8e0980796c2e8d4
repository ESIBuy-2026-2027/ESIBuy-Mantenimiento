,WAAW,OAAO;gBAAO;KAAkB;;;;;KACjD,iDAAC,QAAD;MAAM,WAAW,OAAO;gBAAQ,sCAAY,KAAK;KAAQ;;;;;KACzD,oDAAC,6BAAD;MAAM,MAAM;MAAK,WAAW,OAAO;gBACjC,iDAAC,QAAD;OAAM,UAAU,OAAO,YAAY;iBAAI,kBAAkB,OAAO,MAAM;MAAQ;;;;;KAC1E;;;;;IACH;;;;;;GAEL,iDAAC,aAAD,EAAqB,OAAS;;;;;GAE9B,iDAAC,OAAD;IAAK,WAAW,OAAO;cAAvB,CACE,iDAAC,MAAD;KAAI,cAAW;KAAqB,WAAW,OAAO;eACnD,OAAO,KAAK,UACX,iDAAC,MAAD;MAAmB,cAAY,UAAU,MAAM;MAAM,WAAW,OAAO;gBAAvE,CACE,iDAAC,OAAD;OAAK,WAAW,OAAO;iBAAvB,CACE,oDAAC,6BAAD;QAAM,QAAO;kBAAY,MAAM,SAAS;OAAsB;;;;iBAC9D,oDAAC,6BAAD;QAAM,MAAM;QAAK,WAAW,OAAO;kBAAnC;SAA0C;SAChC,MAAM;SAAG;SAAI,UAAU,MAAM,OAAO,MAAM;QAC9C;;;;;eACH;;;;;gBACL,iDAAC,QAAD;OAAM,WAAW,OAAO;iBAAS,sCAAY,MAAM,KAAK;MAAQ;;;;cAC9D;QARK,MAAM;;;;YAQX,CACL;IACC;;;;cAEJ,iDAAC,YAAD;KAAU,WAAW,OAAO;eAA5B;MACE,iDAAC,UAAD;OAAQ,WAAW,OAAO;iBAAc;MAAkB;;;;;MAC1D,iDAAC,QAAD;OAAM,WAAW,OAAO;OAAY,eAAY;iBAC9C,iDAAC,OAAD,CAAQ;;;;;MACJ;;;;;MACN,iDAAC,OAAD;OAAK,WAAW,OAAO;iBAAvB,CACE,oDAAC,6BAAD;QAAM,MAAM;QAAK,WAAW,OAAO;kBAChC;OACG;;;;iBACN,oDAAC,6BAAD;QAAM,QAAO;QAAW,WAAW,OAAO;kBACvC,cAAc;OACX;;;;eACH;;;;;;KACG;;;;;YACP;;;;;;GAEL,iDAAC,aAAD,EAAqB,OAAS;;;;;GAE9B,iDAAC,OAAD;IAAK,eAAY;IAAmB,eAAY;IAAO,WAAW,OAAO;cACtE,OAAO,KAAK,UACX,iDAAC,QAAD;KAEE,WAAW,OAAO;KAClB,OAAO,EAAE,OAAO,GAAG,MAAM,MAAM,IAAI;IACpC,GAHM,MAAM;;;;WAGZ,CACF;GACE;;;;;EACE;;;;;;AAEb;AAEA,cAAc,YAAY;CACxB,QAAQ,8BAAU,QAChB,8BAAU,MAAM;EACd,IAAI,8BAAU,OAAO;EACrB,UAAU,8BAAU,MAAM,EACxB,iBAAiB,8BAAU,OAAO,WACpC,CAAC,CAAC,CAAC;EACH,OAAO,8BAAU,OAAO;EACxB,QAAQ,8BAAU,MAAM;CAC1B,CAAC,CACH,CAAC,CAAC;CACF,eAAe,8BAAU,MAAM;EAC7B,MAAM,8BAAU,OAAO;EACvB,SAAS,8BAAU,OAAO;CAC5B,CAAC,CAAC,CAAC;CACH,QAAQ,8BAAU,WAAW,IAAI,CAAC,CAAC;AACrC","names":[],"ignoreList":[],"sources":["PaymentTicket.jsx"],"sourcesContent":["\r\nimport { useState } from 'react'\r\nimport PropTypes from 'prop-types'\r\nimport { Text, makeStyles, tokens } from '@fluentui/react-components'\r\nimport { Checkmark28Filled } from '@fluentui/react-icons'\r\nimport { formatPrice } from '../../utils/format'\r\nimport { TIPOS_DE_METODO } from '../paymentMethods/tiposDeMetodo'\r\n\r\nconst PIEZAS_DE_CONFETI = 14\r\nconst NOTCH = '24px'\r\n\r\nconst dateTimeFormatter = new Intl.DateTimeFormat('es-ES', {\r\n  dateStyle: 'long',\r\n  timeStyle: 'short',\r\n})\r\n\r\nconst redondear = (importe) => Math.round(importe * 100) / 100\r\nconst productos = (n) => `${n} ${n === 1 ? 'producto' : 'productos'}`\r\n\r\n// jsdom y algunos navegadores antiguos no tienen matchMedia: entonces se muestra el confeti.\r\nconst prefiereMenosMovimiento = () =>\r\n  typeof window.matchMedia === 'function' &&\r\n  window.matchMedia('(prefers-reduced-motion: reduce)').matches\r\n\r\n// Barras del código de barras decorativo: anchos fijos para que no cambie entre renderizados.\r\nconst BARRAS = [\r\n  3, 1, 2, 1, 3, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1,\r\n  2, 3, 1, 2, 1, 1, 3, 2, 1, 2, 1, 3, 1, 1, 2, 1,\r\n].map((ancho, i) => ({ id: `barra-${i}`, ancho }))\r\n\r\n// Posición, retraso, giro y deriva de cada pieza de confeti, repartidos de forma determinista.\r\nconst CONFETI = Array.from({ length: PIEZAS_DE_CONFETI }, (_, i) => ({\r\n  id: `confeti-${i}`,\r\n  left: `${6 + ((i * 37) % 88)}%`,\r\n  delay: `${(i % 5) * 60}ms`,\r\n  giro: `${(i % 2 === 0 ? 1 : -1) * (180 + i * 25)}deg`,\r\n  deriva: `${((i * 13) % 40) - 20}px`,\r\n  tono: i % 3,\r\n}))\r\n\r\nconst useStyles = makeStyles({\r\n  ticket: {\r\n    position: 'relative',\r\n    width: '100%',\r\n    maxWidth: '440px',\r\n    boxSizing: 'border-box',\r\n    overflow: 'hidden',\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    backgroundColor: tokens.colorNeutralBackground1,\r\n    border: `1px solid ${tokens.colorNeutralStroke2}`,\r\n    borderRadius: tokens.borderRadiusXLarge,\r\n    boxShadow: tokens.shadow4,\r\n  },\r\n  header: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingVerticalS,\r\n    padding: `${tokens.spacingVerticalXXL} ${tokens.spacingHorizontalXL} ${tokens.spacingVerticalL}`,\r\n    textAlign: 'center',\r\n  },\r\n  medallion: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n    width: '56px',\r\n    height: '56px',\r\n    borderRadius: tokens.borderRadiusCircular,\r\n    backgroundColor: tokens.colorBrandBackground2,\r\n    color: tokens.colorBrandForeground1,\r\n  },\r\n  muted: {\r\n    color: tokens.colorNeutralForeground3,\r\n  },\r\n  total: {\r\n    fontSize: tokens.fontSizeHero800,\r\n    lineHeight: tokens.lineHeightHero800,\r\n    fontWeight: tokens.fontWeightBold,\r\n    fontVariantNumeric: 'tabular-nums',\r\n  },\r\n  // Línea discontinua con un troquel semicircular a cada lado, como el corte de un ticket.\r\n  perforation: {\r\n    position: 'relative',\r\n    height: NOTCH,\r\n    flexShrink: 0,\r\n    '::before': {\r\n      content: '\"\"',\r\n      position: 'absolute',\r\n      top: '50%',\r\n      left: NOTCH,\r\n      right: NOTCH,\r\n      borderTop: `2px dashed ${tokens.colorNeutralStroke2}`,\r\n    },\r\n  },\r\n  notch: {\r\n    position: 'absolute',\r\n    top: 0,\r\n    width: NOTCH,\r\n    height: NOTCH,\r\n    boxSizing: 'border-box',\r\n    borderRadius: tokens.borderRadiusCircular,\r\n    backgroundColor: tokens.colorNeutralBackground1,\r\n    border: `1px solid ${tokens.colorNeutralStroke2}`,\r\n  },\r\n  notchStart: {\r\n    left: `calc(${NOTCH} / -2)`,\r\n  },\r\n  notchEnd: {\r\n    right: `calc(${NOTCH} / -2)`,\r\n  },\r\n  body: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalL,\r\n    padding: `${tokens.spacingVerticalM} ${tokens.spacingHorizontalXL}`,\r\n  },\r\n  orders: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalM,\r\n    margin: 0,\r\n    padding: 0,\r\n    listStyleType: 'none',\r\n  },\r\n  order: {\r\n    display: 'flex',\r\n    alignItems: 'baseline',\r\n    justifyContent: 'space-between',\r\n    gap: tokens.spacingHorizontalM,\r\n  },\r\n  orderInfo: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    minWidth: 0,\r\n    overflowWrap: 'anywhere',\r\n  },\r\n  amount: {\r\n    fontWeight: tokens.fontWeightSemibold,\r\n    fontVariantNumeric: 'tabular-nums',\r\n  },\r\n  method: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingHorizontalM,\r\n    padding: tokens.spacingHorizontalM,\r\n    backgroundColor: tokens.colorNeutralBackground2,\r\n    border: 0,\r\n    borderRadius: tokens.borderRadiusLarge,\r\n    minWidth: 0,\r\n  },\r\n  methodLegend: {\r\n    position: 'absolute',\r\n    width: '1px',\r\n    height: '1px',\r\n    padding: 0,\r\n    margin: '-1px',\r\n    overflow: 'hidden',\r\n    clip: 'rect(0, 0, 0, 0)',\r\n    whiteSpace: 'nowrap',\r\n    border: 0,\r\n  },\r\n  methodIcon: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n    flexShrink: 0,\r\n    width: '36px',\r\n    height: '36px',\r\n    borderRadius: tokens.borderRadiusCircular,\r\n    backgroundColor: tokens.colorBrandBackground2,\r\n    color: tokens.colorBrandForeground1,\r\n  },\r\n  methodText: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    minWidth: 0,\r\n  },\r\n  mask: {\r\n    fontVariantNumeric: 'tabular-nums',\r\n    letterSpacing: '0.04em',\r\n  },\r\n  barcode: {\r\n    display: 'flex',\r\n    justifyContent: 'center',\r\n    gap: '2px',\r\n    height: '44px',\r\n    padding: `0 ${tokens.spacingHorizontalXL} ${tokens.spacingVerticalXL}`,\r\n  },\r\n  bar: {\r\n    height: '100%',\r\n    backgroundColor: tokens.colorNeutralForeground1,\r\n  },\r\n  confetti: {\r\n    position: 'absolute',\r\n    inset: 0,\r\n    overflow: 'hidden',\r\n    pointerEvents: 'none',\r\n    '@media (prefers-reduced-motion: reduce)': {\r\n      display: 'none',\r\n    },\r\n  },\r\n  piece: {\r\n    position: 'absolute',\r\n    top: '-12px',\r\n    width: '8px',\r\n    height: '12px',\r\n    borderRadius: tokens.borderRadiusSmall,\r\n    opacity: 0,\r\n    animationName: {\r\n      '0%': { opacity: 1, transform: 'translate(0, 0) rotate(0deg)' },\r\n      '100%': { opacity: 0, transform: 'translate(var(--deriva), 200px) rotate(var(--giro))' },\r\n    },\r\n    animationDuration: '1200ms',\r\n    animationTimingFunction: tokens.curveDecelerateMid,\r\n    animationFillMode: 'both',\r\n  },\r\n  // Solo tonos de la rampa naranja de marca: el naranja es el único acento (DESIGN.md).\r\n  tone0: { backgroundColor: tokens.colorBrandBackground },\r\n  tone1: { backgroundColor: tokens.colorBrandBackgroundHover },\r\n  tone2: { backgroundColor: tokens.colorBrandStroke2 },\r\n})\r\n\r\nfunction Perforation({ styles }) {\r\n  return (\r\n    <div className={styles.perforation} aria-hidden=\"true\">\r\n      <span className={`${styles.notch} ${styles.notchStart}`} />\r\n      <span className={`${styles.notch} ${styles.notchEnd}`} />\r\n    </div>\r\n  )\r\n}\r\n\r\nPerforation.propTypes = {\r\n  styles: PropTypes.object.isRequired,\r\n}\r\n\r\n// Recibo del pago (HU10) con forma de ticket: el total cobrado, la fecha, un pedido por proveedor y el método de pago\r\n// usado, solo con su máscara. El confeti y el código de barras son decorativos y no llegan a los lectores de pantalla;\r\n// el confeti no aparece si el usuario prefiere reducir el movimiento.\r\nexport default function PaymentTicket({ orders, paymentMethod, paidAt }) {\r\n  const styles = useStyles()\r\n  const [conConfeti] = useState(() => !prefiereMenosMovimiento())\r\n  const total = redondear(orders.reduce((suma, order) => suma + order.total, 0))\r\n  const { etiqueta, Icono } = TIPOS_DE_METODO[paymentMethod.tipo]\r\n\r\n  return (\r\n    <section aria-label=\"Recibo del pago\" className={styles.ticket}>\r\n      {conConfeti && (\r\n        <div data-testid=\"confeti\" aria-hidden=\"true\" className={styles.confetti}>\r\n          {CONFETI.map((pieza) => (\r\n            <span\r\n              key={pieza.id}\r\n              className={[styles.piece, styles[`tone${pieza.tono}`]].join(' ')}\r\n              style={{\r\n                left: pieza.left,\r\n                animationDelay: pieza.delay,\r\n                '--giro': pieza.giro,\r\n                '--deriva': pieza.deriva,\r\n              }}\r\n            />\r\n          ))}\r\n        </div>\r\n      )}\r\n\r\n      <div className={styles.header}>\r\n        <span className={styles.medallion} aria-hidden=\"true\">\r\n          <Checkmark28Filled />\r\n        </span>\r\n        <Text className={styles.muted}>Total pagado</Text>\r\n        <span className={styles.total}>{formatPrice(total)}</span>\r\n        <Text size={200} className={styles.muted}>\r\n          <time dateTime={paidAt.toISOString()}>{dateTimeFormatter.format(paidAt)}</time>\r\n        </Text>\r\n      </div>\r\n\r\n      <Perforation styles={styles} />\r\n\r\n      <div className={styles.body}>\r\n        <ul aria-label=\"Pedidos realizados\" className={styles.orders}>\r\n          {orders.map((order) => (\r\n            <li key={order.id} aria-label={`Pedido ${order.id}`} className={styles.order}>\r\n              <div className={styles.orderInfo}>\r\n                <Text weight=\"semibold\">{order.vendedor.nombreComercial}</Text>\r\n                <Text size={200} className={styles.muted}>\r\n                  Pedido {order.id} · {productos(order.lineas.length)}\r\n                </Text>\r\n              </div>\r\n              <span className={styles.amount}>{formatPrice(order.total)}</span>\r\n            </li>\r\n          ))}\r\n        </ul>\r\n\r\n        <fieldset className={styles.method}>\r\n          <legend className={styles.methodLegend}>Pagado con</legend>\r\n          <span className={styles.methodIcon} aria-hidden=\"true\">\r\n            <Icono />\r\n          </span>\r\n          <div className={styles.methodText}>\r\n            <Text size={200} className={styles.muted}>\r\n              {etiqueta}\r\n            </Text>\r\n            <Text weight=\"semibold\" className={styles.mask}>\r\n              {paymentMethod.mascara}\r\n            </Text>\r\n          </div>\r\n        </fieldset>\r\n      </div>\r\n\r\n      <Perforation styles={styles} />\r\n\r\n      <div data-testid=\"codigo-de-barras\" aria-hidden=\"true\" className={styles.barcode}>\r\n        {BARRAS.map((barra) => (\r\n          <span\r\n            key={barra.id}\r\n            className={styles.bar}\r\n            style={{ width: `${barra.ancho}px` }}\r\n          />\r\n        ))}\r\n      </div>\r\n    </section>\r\n  )\r\n}\r\n\r\nPaymentTicket.propTypes = {\r\n  orders: PropTypes.arrayOf(\r\n    PropTypes.shape({\r\n      id: PropTypes.string.isRequired,\r\n      vendedor: PropTypes.shape({\r\n        nombreComercial: PropTypes.string.isRequired,\r\n      }).isRequired,\r\n      total: PropTypes.number.isRequired,\r\n      lineas: PropTypes.array.isRequired,\r\n    }),\r\n  ).isRequired,\r\n  paymentMethod: PropTypes.shape({\r\n    tipo: PropTypes.string.isRequired,\r\n    mascara: PropTypes.string.isRequired,\r\n  }).isRequired,\r\n  paidAt: PropTypes.instanceOf(Date).isRequired,\r\n}\r\n"],"file":"/frontend/src/features/checkout/PaymentTicket.jsx"}