AW,QAAQ,QAAQ,MAAM,KAAK,CAAC;CAC7C,MAAM,QAAQ,QAAQ,eAAe,QAAQ,QAAQ,kBAAkB;CAEvE,0CAAgB;EACd,MAAM,QAAQ,SAAS;EACvB,IAAI,CAAC,OAAO,OAAO;EAEnB,MAAM,oBAAoB,eAAe,IAAI;EAC7C,MAAM,iBAAiB,SAAS,WAAW;EAC3C,IAAI,MAAM,YAAY,MAAM,iBAAiB,GAAG,YAAY;EAE5D,aAAa,MAAM,oBAAoB,SAAS,WAAW;CAC7D,GAAG,CAAC,CAAC;CAEL,MAAM,CAAC,gBAAgB,qBAAqB,mCAAS,KAAK;CAC1D,MAAM,CAAC,eAAe,oBAAoB,mCAAS,EAAE;CAErD,MAAM,mBAAmB,YAAY;EACnC,IAAI,UAAU,OAAO;EAErB,OAAO,SAAS,SAAS,sBACrB,yCACA;CACN;CAEA,MAAM,iBAAiB,YAAY;EACjC,iBAAiB,EAAE;EACnB,kBAAkB,IAAI;EAEtB,IAAI;GACF,OAAO,WAAW,iBAAiB,QAAQ,EAAE,IAAI,cAAc,QAAQ,EAAE;EAC3E,SAAS,SAAS;GAChB,iBAAiB,gBAAgB,OAAO,CAAC;EAC3C,UAAU;GACR,kBAAkB,KAAK;EACzB;CACF;CAEA,OACE,kDAAC,OAAD;EAAK,WAAW,OAAO;YAAvB;GACE,qDAAC,6BAAD;IAAM,IAAI,+CAAqB,QAAQ,EAAE;IAAG,WAAW,OAAO;cAA9D,CACE,kDAAC,QAAD;KAAM,WAAW,OAAO;eACrB,WACC,kDAAC,OAAD;MACE,KAAK;MACL,WAAW,OAAO;MAClB,KAAK,QAAQ;MACb,KAAK,QAAQ;MACb,SAAQ;KACT;;;;gBAED,kDAAC,QAAD;MAAM,WAAW,OAAO;gBACtB,kDAAC,OAAD;OACE,WAAW,OAAO;OAClB,KAAI;OACJ,KAAI;MACL;;;;;KACG;;;;;IAEJ;;;;cAEN,kDAAC,QAAD;KAAM,WAAW,OAAO;eAAxB;MACE,qDAAC,6BAAD;OAAM,MAAM;OAAK,WAAW,OAAO;iBAChC,gBAAgB;MACb;;;;;MAEN,qDAAC,6BAAD;OAAM,QAAO;OAAW,MAAM;OAAK,WAAW,OAAO;iBAClD,QAAQ;MACL;;;;;MAEN,kDAAC,QAAD;OAAM,WAAW,OAAO;iBACrB,QACC;QACE,kDAAC,QAAD,aACE,kDAAC,OAAD;SACE,WAAW,OAAO;SAClB,KAAI;SACJ,KAAK,eAAe,uCAAa,QAAQ,UAAU,EAAE;SACrD,cAAY,eAAe,uCAAa,QAAQ,UAAU,EAAE;QAC7D;;;;kBACD,kDAAC,QAAD;SAAM,eAAY;mBAChB,qDAAC,iCAAD,EAAa,OAAO,QAAQ,WAAa;;;;;QACrC;;;;gBACF;;;;;QACN,qDAAC,6BAAD;SAAM,QAAO;mBACV,uCAAa,QAAQ,UAAU;QAC5B;;;;;QAEN,qDAAC,6BAAD;SAAM,WAAW,OAAO;mBAAxB;UAA+B;UAC3B,QAAQ;UAAgB;SACtB;;;;;;OACN;;;;kBAEF,qDAAC,6BAAD;QAAM,WAAW,OAAO;kBAAO;OAAsB;;;;;MAEnD;;;;;KACF;;;;;YACF;;;;;;GAEL,iBAAiB,QAAQ,cACxB,qDAAC,+BAAD;IACE,IAAG;IACH,OAAM;IACN,WAAW,OAAO;IAClB,MAAM,WAAW,qDAAC,sCAAD,EAAe,WAAW,OAAO,aAAe;;;;eAAI,qDAAC,uCAAD,CAAiB;;;;;IACtF,cACE,WACI,UAAU,QAAQ,OAAO,iBACzB,UAAU,QAAQ,OAAO;IAE/B,OAAO,WAAW,wBAAwB;IAC1C,UAAU,kBAAmB,YAAY,CAAC;IAC1C,SAAS;GACV;;;;;GAGH,kDAAC,OAAD;IAAK,WAAW,OAAO;cAAvB;KACE,qDAAC,gCAAD;MACE;MACA,QAAQ,QAAQ;MAChB,WAAW,QAAQ;MACnB,aAAa,QAAQ;KACtB;;;;;KAED,qDAAC,gCAAD;MAA0B;MAAS,MAAK;MAAQ;KAAW;;;;;KAE1D,iBACC,qDAAC,6BAAD;MAAM,MAAK;MAAQ,MAAM;MAAK,WAAW,OAAO;gBAC7C;KACG;;;;;IAEL;;;;;;EACF;;;;;;AAET;AAEA,YAAY,YAAY;CACtB,SAAS,6CAAuB;CAChC,cAAc,8BAAU;CACxB,UAAU,8BAAU;CACpB,eAAe,8BAAU;CACzB,kBAAkB,8BAAU;AAC9B","names":[],"ignoreList":[],"sources":["ProductCard.jsx"],"sourcesContent":["\r\nimport PropTypes from 'prop-types'\r\nimport { useEffect, useRef, useState } from 'react'\r\nimport { Link } from 'react-router-dom'\r\nimport { Button, Text, makeStyles, tokens } from '@fluentui/react-components'\r\nimport { Heart20Filled, Heart20Regular } from '@fluentui/react-icons'\r\nimport { getProductDetailPath } from '../../routes/paths'\r\nimport { catalogProductPropType } from '../../utils/propTypes'\r\nimport { formatRating } from '../../utils/format'\r\nimport AddToCartButton from '../cart/AddToCartButton'\r\nimport PriceBlock from './PriceBlock'\r\nimport RatingStars from './RatingStars'\r\n\r\nconst SIN_CATEGORIA = '—'\r\n\r\nconst useStyles = makeStyles({\r\n  // La tarjeta es un contenedor con dos partes: el enlace al detalle del producto (imagen, categoría, nombre y\r\n  // valoración) y, debajo, el precio y el botón de añadir al carrito, que no puede ir dentro del enlace. El corazón de\r\n  // favoritos tampoco: se coloca encima de la esquina de la imagen.\r\n  card: {\r\n    position: 'relative',\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    width: '100%',\r\n    height: '100%',\r\n    overflow: 'hidden',\r\n    backgroundColor: tokens.colorNeutralBackground1,\r\n    border: `1px solid ${tokens.colorNeutralStroke2}`,\r\n    borderRadius: tokens.borderRadiusXLarge,\r\n    boxShadow: tokens.shadow2,\r\n    transitionProperty: 'box-shadow, transform, border-color',\r\n    transitionDuration: tokens.durationNormal,\r\n    transitionTimingFunction: tokens.curveEasyEase,\r\n    ':hover': {\r\n      transform: 'translateY(-3px)',\r\n      boxShadow: tokens.shadow16,\r\n      borderColor: tokens.colorNeutralStroke1,\r\n    },\r\n  },\r\n  link: {\r\n    textDecoration: 'none',\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    flexGrow: 1,\r\n    font: 'inherit',\r\n    color: 'inherit',\r\n    cursor: 'pointer',\r\n    ':focus-visible': {\r\n      outline: `2px solid ${tokens.colorStrokeFocus2}`,\r\n      outlineOffset: '-2px',\r\n    },\r\n  },\r\n  media: {\r\n    position: 'relative',\r\n    display: 'block',\r\n    aspectRatio: '4 / 3',\r\n    overflow: 'hidden',\r\n    backgroundColor: tokens.colorNeutralBackground3,\r\n  },\r\n  image: {\r\n    display: 'block',\r\n    width: '100%',\r\n    height: '100%',\r\n    objectFit: 'cover',\r\n    transitionProperty: 'transform',\r\n    transitionDuration: tokens.durationUltraSlow,\r\n    transitionTimingFunction: tokens.curveEasyEase,\r\n  },\r\n  placeholder: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n    width: '100%',\r\n    height: '100%',\r\n    color: tokens.colorNeutralForeground4,\r\n  },\r\n  body: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    flexGrow: 1,\r\n    gap: tokens.spacingVerticalXS,\r\n    padding: `${tokens.spacingVerticalM} ${tokens.spacingHorizontalM} ${tokens.spacingVerticalXS}`,\r\n    '@media (min-width: 600px)': {\r\n      padding: `${tokens.spacingVerticalL} ${tokens.spacingHorizontalL} ${tokens.spacingVerticalS}`,\r\n    },\r\n  },\r\n  category: {\r\n    color: tokens.colorBrandForeground1,\r\n    textTransform: 'uppercase',\r\n    letterSpacing: '0.04em',\r\n    fontWeight: tokens.fontWeightSemibold,\r\n  },\r\n  name: {\r\n    display: '-webkit-box',\r\n    WebkitLineClamp: 2,\r\n    WebkitBoxOrient: 'vertical',\r\n    overflow: 'hidden',\r\n    overflowWrap: 'anywhere',\r\n    lineHeight: tokens.lineHeightBase300,\r\n    minHeight: `calc(2 * ${tokens.lineHeightBase300})`,\r\n  },\r\n  rating: {\r\n    display: 'flex',\r\n    flexWrap: 'wrap',\r\n    alignItems: 'center',\r\n    gap: tokens.spacingHorizontalXS,\r\n    marginTop: 'auto',\r\n    paddingTop: tokens.spacingVerticalXS,\r\n  },\r\n  footer: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalS,\r\n    padding: `${tokens.spacingVerticalXS} ${tokens.spacingHorizontalM} ${tokens.spacingVerticalM}`,\r\n    '@media (min-width: 600px)': {\r\n      padding: `${tokens.spacingVerticalXS} ${tokens.spacingHorizontalL} ${tokens.spacingVerticalL}`,\r\n    },\r\n  },\r\n  muted: {\r\n    color: tokens.colorNeutralForeground3,\r\n  },\r\n  error: {\r\n    color: tokens.colorPaletteRedForeground1,\r\n  },\r\n  favorite: {\r\n    position: 'absolute',\r\n    top: tokens.spacingVerticalS,\r\n    right: tokens.spacingHorizontalS,\r\n    backgroundColor: tokens.colorNeutralBackground1,\r\n    boxShadow: tokens.shadow4,\r\n  },\r\n  // El corazón relleno en rojo es la señal de que ya está en favoritos, también mientras se quita.\r\n  favoriteIcon: {\r\n    color: tokens.colorPaletteRedForeground1,\r\n  },\r\n  srOnly: {\r\n    position: 'absolute',\r\n    width: '1px',\r\n    height: '1px',\r\n    padding: 0,\r\n    margin: '-1px',\r\n    overflow: 'hidden',\r\n    clip: 'rect(0, 0, 0, 0)',\r\n    whiteSpace: 'nowrap',\r\n    border: 0,\r\n  },\r\n  placeholderImage: {\r\n    width: '24px',\r\n    height: '24px',\r\n    objectFit: 'contain',\r\n  },\r\n})\r\n\r\n// Tarjeta de un producto del catálogo: lo que se ve desde fuera (imagen, nombre, categoría, valoración y precio) y\r\n// el botón para añadirlo al carrito (HU9). `categoryName` lo traduce la página a partir del identificador de\r\n// categoría del producto. La imagen, el nombre y la valoración llevan al detalle (HU8). Con `onAddFavorite`, la\r\n// tarjeta tiene además un corazón para añadir el producto a favoritos (HU14), salvo si no está disponible, porque el\r\n// backend no lo aceptaría; uno agotado sí se puede añadir. Con `favorite`, el corazón sale relleno y, con\r\n// `onRemoveFavorite`, al pulsarlo se quita de favoritos. Si no se puede añadir o quitar, la tarjeta lo avisa.\r\nexport default function ProductCard({\r\n  product,\r\n  categoryName,\r\n  favorite = false,\r\n  onAddFavorite,\r\n  onRemoveFavorite,\r\n}) {\r\n  const styles = useStyles()\r\n\r\n  // Si la imagen no carga (dirección rota), se enseña el mismo marcador que cuando no hay imagen.\r\n  const [imageFailed, setImageFailed] = useState(false)\r\n  const imageRef = useRef(null)\r\n  const hasImage = Boolean(product.imagen) && !imageFailed\r\n  const rated = product.valoracion !== null && product.numValoraciones > 0\r\n\r\n  useEffect(() => {\r\n    const image = imageRef.current\r\n    if (!image) return undefined\r\n\r\n    const handleError = () => setImageFailed(true)\r\n    image.addEventListener('error', handleError)\r\n    if (image.complete && image.naturalWidth === 0) handleError()\r\n\r\n    return () => image.removeEventListener('error', handleError)\r\n  }, [])\r\n\r\n  const [savingFavorite, setSavingFavorite] = useState(false)\r\n  const [favoriteError, setFavoriteError] = useState('')\r\n\r\n  const favoriteFailure = (failure) => {\r\n    if (favorite) return 'No se ha podido quitar de favoritos. Inténtalo de nuevo.'\r\n\r\n    return failure?.code === 'PRODUCT_NOT_FOUND'\r\n      ? 'Este producto ya no está disponible.'\r\n      : 'No se ha podido añadir a favoritos. Inténtalo de nuevo.'\r\n  }\r\n\r\n  const toggleFavorite = async () => {\r\n    setFavoriteError('')\r\n    setSavingFavorite(true)\r\n\r\n    try {\r\n      await (favorite ? onRemoveFavorite(product.id) : onAddFavorite(product.id))\r\n    } catch (failure) {\r\n      setFavoriteError(favoriteFailure(failure))\r\n    } finally {\r\n      setSavingFavorite(false)\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.card}>\r\n      <Link to={getProductDetailPath(product.id)} className={styles.link}>\r\n        <span className={styles.media}>\r\n          {hasImage ? (\r\n            <img\r\n              ref={imageRef}\r\n              className={styles.image}\r\n              src={product.imagen}\r\n              alt={product.nombre}\r\n              loading=\"lazy\"\r\n            />\r\n          ) : (\r\n            <span className={styles.placeholder}>\r\n              <img\r\n                className={styles.placeholderImage}\r\n                src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M3 3l18 18M10 12l-4 6h12l-3-4-2 2M6 6h11a2 2 0 0 1 2 2v8' fill='none' stroke='%23999999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E\"\r\n                alt=\"Sin imagen\"\r\n              />\r\n            </span>\r\n          )}\r\n        </span>\r\n\r\n        <span className={styles.body}>\r\n          <Text size={200} className={styles.category}>\r\n            {categoryName ?? SIN_CATEGORIA}\r\n          </Text>\r\n\r\n          <Text weight=\"semibold\" size={400} className={styles.name}>\r\n            {product.nombre}\r\n          </Text>\r\n\r\n          <span className={styles.rating}>\r\n            {rated ? (\r\n              <>\r\n                <span>\r\n                  <img\r\n                    className={styles.srOnly}\r\n                    src=\"data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=\"\r\n                    alt={`Valoración: ${formatRating(product.valoracion)} de 5`}\r\n                    aria-label={`Valoración: ${formatRating(product.valoracion)} de 5`}\r\n                  />\r\n                  <span aria-hidden=\"true\">\r\n                    <RatingStars value={product.valoracion} />\r\n                  </span>\r\n                </span>\r\n                <Text weight=\"semibold\">\r\n                  {formatRating(product.valoracion)}\r\n                </Text>\r\n\r\n                <Text className={styles.muted}>\r\n                  ({product.numValoraciones})\r\n                </Text>\r\n              </>\r\n            ) : (\r\n              <Text className={styles.muted}>Sin valoraciones</Text>\r\n            )}\r\n          </span>\r\n        </span>\r\n      </Link>\r\n\r\n      {onAddFavorite && product.disponible && (\r\n        <Button\r\n          as=\"button\"\r\n          shape=\"circular\"\r\n          className={styles.favorite}\r\n          icon={favorite ? <Heart20Filled className={styles.favoriteIcon} /> : <Heart20Regular />}\r\n          aria-label={\r\n            favorite\r\n              ? `Quitar ${product.nombre} de favoritos`\r\n              : `Añadir ${product.nombre} a favoritos`\r\n          }\r\n          title={favorite ? 'Quitar de favoritos' : 'Añadir a favoritos'}\r\n          disabled={savingFavorite || (favorite && !onRemoveFavorite)}\r\n          onClick={toggleFavorite}\r\n        />\r\n      )}\r\n\r\n      <div className={styles.footer}>\r\n        <PriceBlock\r\n          compact\r\n          precio={product.precio}\r\n          descuento={product.descuento}\r\n          precioFinal={product.precioFinal}\r\n        />\r\n\r\n        <AddToCartButton product={product} size=\"small\" fullWidth />\r\n\r\n        {favoriteError && (\r\n          <Text role=\"alert\" size={200} className={styles.error}>\r\n            {favoriteError}\r\n          </Text>\r\n        )}\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nProductCard.propTypes = {\r\n  product: catalogProductPropType.isRequired,\r\n  categoryName: PropTypes.string,\r\n  favorite: PropTypes.bool,\r\n  onAddFavorite: PropTypes.func,\r\n  onRemoveFavorite: PropTypes.func,\r\n}\r\n"],"file":"/frontend/src/features/catalog/ProductCard.jsx"}