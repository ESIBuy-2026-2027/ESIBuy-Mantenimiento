AAE,OAAO,UAAU,YAC7B,oDAAC,qCAAD;MAEE,WAAW,OAAO;MAClB,MAAM,iDAAC,OAAD,CAAQ;;;;;MACd,SAAS,SAAS;MAClB,eAAe,QAAQ,KAAK;gBAE3B;KACW,GAPP;;;;YAOO,CACf,CACO;;;;;;IAET,SAAS,aACR,iDAAC,OAAD;KAAK,WAAW,OAAO;eAAvB;MACE,oDAAC,8BAAD;OAAO,OAAM;OAAoB,GAAI,MAAM,eAAe;iBACxD,oDAAC,8BAAD;QACE,GAAI,MAAM,eAAe;QACzB,eAAe,oDAAC,yCAAD,CAAmB;;;;;QAClC,aAAY;QACZ,WAAU;QACV,WAAW;QACX,cAAa;OACd;;;;;MACI;;;;;MACP,iDAAC,OAAD;OAAK,WAAW,OAAO;iBAAvB,CACE,oDAAC,8BAAD;QAAO,OAAM;QAAY,GAAI,MAAM,WAAW;kBAC5C,oDAAC,8BAAD;SACE,GAAI,MAAM,WAAW;SACrB,WAAW,OAAO;SAClB,eAAe,oDAAC,0CAAD,CAAoB;;;;;SACnC,aAAY;SACZ,WAAU;SACV,WAAW;SACX,cAAa;QACd;;;;;OACI;;;;iBACP,oDAAC,8BAAD;QAAO,OAAM;QAAM,GAAI,MAAM,KAAK;kBAChC,oDAAC,8BAAD;SACE,GAAI,MAAM,KAAK;SACf,WAAW,OAAO;SAClB,eAAe,oDAAC,4CAAD,CAAsB;;;;;SACrC,MAAK;SACL,aAAY;SACZ,WAAU;SACV,WAAW;SACX,cAAa;QACd;;;;;OACI;;;;eACJ;;;;;;MACL,oDAAC,8BAAD;OAAO,OAAM;OAAU,GAAI,MAAM,SAAS;iBACxC,oDAAC,8BAAD;QAAO,GAAI,MAAM,SAAS;QAAG,aAAY;QAAqB,cAAa;OAAW;;;;;MACjF;;;;;KACJ;;;;;;IAGN,SAAS,YACR,oDAAC,8BAAD;KAAO,OAAM;KAAgB,GAAI,MAAM,WAAW;eAChD,oDAAC,8BAAD;MAAO,GAAI,MAAM,WAAW;MAAG,eAAe,oDAAC,uCAAD,CAAiB;;;;;MAAG,MAAK;MAAM,aAAY;KAA+B;;;;;IACnH;;;;;IAGR,SAAS,WACR,oDAAC,8BAAD;KAAO,OAAM;KAAoB,GAAI,MAAM,eAAe;eACxD,oDAAC,8BAAD;MAAO,GAAI,MAAM,eAAe;MAAG,eAAe,oDAAC,uCAAD,CAAiB;;;;;MAAG,MAAK;MAAM,WAAU;MAAU,WAAW;MAAG,aAAY;MAAY,cAAa;KAAgB;;;;;IACnK;;;;;IAGT,iDAAC,OAAD;KAAK,WAAW,OAAO;eAAvB,CACE,oDAAC,+BAAD;MAAQ,YAAW;MAAU,SAAS;gBAAS;KAEvC;;;;eACR,oDAAC,+BAAD;MAAQ,YAAW;MAAS,SAAS;gBAAU;KAEvC;;;;aACL;;;;;;IAEL,oDAAC,6BAAD;KAAM,MAAM;KAAK,WAAW,OAAO;eAAnC,CACE,oDAAC,4CAAD,EAAqB,oBAAa;;;;eAAC,6DAE/B;;;;;;GACF;;;;;;CACC;;;;;AAEb;AAEA,sBAAsB,YAAY;CAChC,SAAS,8BAAU,KAAK;CACxB,UAAU,8BAAU,KAAK;AAC3B","names":[],"ignoreList":[],"sources":["AddPaymentMethodPanel.jsx"],"sourcesContent":["import { useState } from 'react'\r\nimport PropTypes from 'prop-types'\r\nimport {\r\n  Button,\r\n  Card,\r\n  Field,\r\n  Input,\r\n  MessageBar,\r\n  MessageBarBody,\r\n  Subtitle1,\r\n  Text,\r\n  ToggleButton,\r\n  makeStyles,\r\n  tokens,\r\n} from '@fluentui/react-components'\r\nimport {\r\n  Calendar20Regular,\r\n  Globe20Regular,\r\n  LockClosed16Regular,\r\n  LockClosed20Regular,\r\n  Payment20Regular,\r\n  Phone20Regular,\r\n  Wallet20Regular,\r\n} from '@fluentui/react-icons'\r\nimport { addPaymentMethod } from '../../api/paymentMethods'\r\n\r\n// Los tres tipos que admite el backend, en el orden de los botones del selector\r\nconst TIPOS = [\r\n  { valor: 'TARJETA', etiqueta: 'Tarjeta', Icono: Payment20Regular },\r\n  { valor: 'PAYPAL', etiqueta: 'PayPal', Icono: Wallet20Regular },\r\n  { valor: 'BIZUM', etiqueta: 'Bizum', Icono: Phone20Regular },\r\n]\r\n\r\nconst CAMPOS_VACIOS = {\r\n  numeroTarjeta: '',\r\n  caducidad: '',\r\n  cvv: '',\r\n  titular: '',\r\n  urlPayPal: '',\r\n  telefonoBizum: '',\r\n}\r\n\r\n// Solo formatos básicos, con los mismos límites que el backend, para avisar antes de enviar. Lo demás (Luhn, que la\r\n// tarjeta no esté caducada) lo comprueba el backend.\r\nconst FORMATO_NUMERO = /^\\d{13,19}$/\r\nconst FORMATO_CADUCIDAD = /^(0[1-9]|1[0-2])\\/\\d{2}$/\r\nconst FORMATO_CVV = /^\\d{3,4}$/\r\nconst FORMATO_TITULAR = /^[\\p{L} '-]{1,26}$/u\r\nconst FORMATO_TELEFONO = /^\\d{9}$/\r\n\r\n// El número se puede escribir con espacios, como en la tarjeta; se envía sin ellos\r\nconst sinEspacios = (texto) => texto.replaceAll(/\\s/g, '')\r\n\r\nconst soloDigitos = (texto, maximo) => texto.replaceAll(/\\D/g, '').slice(0, maximo)\r\n\r\n// Formato mientras se escribe: solo dígitos y nunca más de los que admite cada campo. El número va en grupos de 4,\r\n// como en la tarjeta; la caducidad pone la barra sola tras el mes (y la quita al borrar), y un mes de una cifra\r\n// mayor que 1 se completa con un 0 delante («4» → «04/»).\r\nconst MAX_DIGITOS_TARJETA = 19\r\nconst formatearNumero = (texto) => soloDigitos(texto, MAX_DIGITOS_TARJETA).replaceAll(/(\\d{4})(?=\\d)/g, '$1 ')\r\n\r\nfunction formatearCaducidad(texto, anterior) {\r\n  let digitos = soloDigitos(texto, 4)\r\n  if (/^[2-9]$/.test(digitos)) digitos = `0${digitos}`\r\n  if (digitos.length > 2) return `${digitos.slice(0, 2)}/${digitos.slice(2)}`\r\n  const escribiendo = texto.length > anterior.length\r\n  return digitos.length === 2 && escribiendo ? `${digitos}/` : digitos\r\n}\r\n\r\nconst FORMATEADORES = {\r\n  numeroTarjeta: formatearNumero,\r\n  caducidad: formatearCaducidad,\r\n  cvv: (texto) => soloDigitos(texto, 4),\r\n  telefonoBizum: (texto) => soloDigitos(texto, 9),\r\n}\r\n\r\nfunction erroresDeTarjeta({ numeroTarjeta, caducidad, cvv, titular }) {\r\n  const errores = {}\r\n  if (!FORMATO_NUMERO.test(sinEspacios(numeroTarjeta))) {\r\n    errores.numeroTarjeta = 'El número de tarjeta tiene entre 13 y 19 dígitos.'\r\n  }\r\n  if (!FORMATO_CADUCIDAD.test(caducidad.trim())) errores.caducidad = 'Escribe la caducidad como MM/AA.'\r\n  if (!FORMATO_CVV.test(cvv)) errores.cvv = 'El CVV tiene 3 o 4 dígitos.'\r\n  if (!FORMATO_TITULAR.test(titular.trim())) {\r\n    errores.titular = 'El titular solo puede tener letras, espacios, guiones y apóstrofos (hasta 26).'\r\n  }\r\n  return errores\r\n}\r\n\r\n// Como el backend: una URL con esquema y servidor\r\nfunction esUrlCompleta(texto) {\r\n  try {\r\n    return new URL(texto.trim()).hostname !== ''\r\n  } catch {\r\n    return false\r\n  }\r\n}\r\n\r\n// Errores de formato del método, según su tipo\r\nfunction erroresDe(tipo, campos) {\r\n  if (tipo === 'TARJETA') return erroresDeTarjeta(campos)\r\n  if (tipo === 'PAYPAL' && !esUrlCompleta(campos.urlPayPal)) {\r\n    return { urlPayPal: 'Escribe una URL completa, como https://paypal.me/tu-cuenta.' }\r\n  }\r\n  if (tipo === 'BIZUM' && !FORMATO_TELEFONO.test(campos.telefonoBizum.trim())) {\r\n    return { telefonoBizum: 'El teléfono tiene 9 dígitos.' }\r\n  }\r\n  return {}\r\n}\r\n\r\n// Mensajes propios según el código del backend: nunca su texto ni los datos enviados\r\nconst MENSAJE_LIMITE = 'Ya tienes 5 métodos de pago. Elimina uno para añadir otro.'\r\nconst MENSAJE_RECHAZO = 'No se ha podido guardar el método de pago. Revisa los datos: puede que la tarjeta esté caducada.'\r\nconst mensajeDeFallo = (error) => (error?.code === 'PAYMENT_METHOD_LIMIT_REACHED' ? MENSAJE_LIMITE : MENSAJE_RECHAZO)\r\n\r\n// Lo que se envía: solo los campos del tipo elegido, aunque se haya escrito en otros\r\nfunction cuerpoDe(tipo, campos) {\r\n  if (tipo === 'TARJETA') {\r\n    return {\r\n      tipo,\r\n      numeroTarjeta: sinEspacios(campos.numeroTarjeta),\r\n      titular: campos.titular.trim(),\r\n      caducidad: campos.caducidad.trim(),\r\n      cvv: campos.cvv,\r\n    }\r\n  }\r\n  if (tipo === 'PAYPAL') return { tipo, urlPayPal: campos.urlPayPal.trim() }\r\n  return { tipo, telefonoBizum: campos.telefonoBizum.trim() }\r\n}\r\n\r\n// Composición inspirada en la tarjeta «Payment Details», adaptada a DESIGN.md: superficie blanca con la sombra del\r\n// panel protagonista (sin efecto cristal), el naranja como único acento y una entrada corta que no se reproduce\r\n// con movimiento reducido.\r\nconst useStyles = makeStyles({\r\n  panel: {\r\n    width: '100%',\r\n    maxWidth: '440px',\r\n    // Centrado en la página, como la tarjeta de referencia\r\n    alignSelf: 'center',\r\n    boxSizing: 'border-box',\r\n    padding: tokens.spacingVerticalXL,\r\n    gap: tokens.spacingVerticalL,\r\n    boxShadow: tokens.shadow28,\r\n    animationName: {\r\n      from: { opacity: 0, transform: 'translateY(8px)' },\r\n      to: { opacity: 1, transform: 'translateY(0)' },\r\n    },\r\n    animationDuration: tokens.durationNormal,\r\n    animationTimingFunction: tokens.curveEasyEase,\r\n    '@media (prefers-reduced-motion: reduce)': {\r\n      animationName: 'none',\r\n    },\r\n  },\r\n  header: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalXXS,\r\n  },\r\n  title: {\r\n    margin: 0,\r\n  },\r\n  muted: {\r\n    color: tokens.colorNeutralForeground3,\r\n  },\r\n  types: {\r\n    display: 'grid',\r\n    gridTemplateColumns: 'repeat(3, minmax(0, 1fr))',\r\n    gap: tokens.spacingHorizontalS,\r\n  },\r\n  type: {\r\n    height: '48px',\r\n  },\r\n  fields: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalM,\r\n  },\r\n  // minmax(0, 1fr) y minWidth 0 en el input: sin ellos, el ancho propio de cada input impide que la columna se\r\n  // estreche y el CVV se sale del panel\r\n  twoColumns: {\r\n    display: 'grid',\r\n    gridTemplateColumns: 'repeat(2, minmax(0, 1fr))',\r\n    alignItems: 'start',\r\n    gap: tokens.spacingHorizontalM,\r\n  },\r\n  shrinkable: {\r\n    minWidth: 0,\r\n  },\r\n  actions: {\r\n    display: 'flex',\r\n    flexDirection: 'column',\r\n    gap: tokens.spacingVerticalS,\r\n  },\r\n  secure: {\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    justifyContent: 'center',\r\n    gap: tokens.spacingHorizontalXS,\r\n    color: tokens.colorNeutralForeground3,\r\n  },\r\n})\r\n\r\n// Alta de un método de pago (HU6). Los datos solo viven en este panel mientras se rellena.\r\nexport default function AddPaymentMethodPanel({ onSaved, onCancel }) {\r\n  const styles = useStyles()\r\n  const [tipo, setTipo] = useState('TARJETA')\r\n  const [campos, setCampos] = useState(CAMPOS_VACIOS)\r\n  const [errores, setErrores] = useState({})\r\n  const [fallo, setFallo] = useState(null)\r\n\r\n  // Props comunes de cada campo: su valor, su cambio (con su formato, si lo tiene) y su mensaje de error\r\n  const campo = (nombre) => ({\r\n    value: campos[nombre],\r\n    onChange: (_event, data) =>\r\n      setCampos((actuales) => {\r\n        const formatear = FORMATEADORES[nombre]\r\n        const valor = formatear ? formatear(data.value, actuales[nombre]) : data.value\r\n        return { ...actuales, [nombre]: valor }\r\n      }),\r\n  })\r\n  const error = (nombre) =>\r\n    errores[nombre] ? { validationState: 'error', validationMessage: errores[nombre] } : {}\r\n\r\n  const guardar = async () => {\r\n    const encontrados = erroresDe(tipo, campos)\r\n    setErrores(encontrados)\r\n    if (Object.keys(encontrados).length > 0) return\r\n    setFallo(null)\r\n    try {\r\n      onSaved(await addPaymentMethod(cuerpoDe(tipo, campos)))\r\n    } catch (error) {\r\n      setFallo(mensajeDeFallo(error))\r\n    }\r\n  }\r\n\r\n  // Los datos de pago no se quedan en memoria: se vacían antes de cerrar el panel\r\n  const cancelar = () => {\r\n    setCampos(CAMPOS_VACIOS)\r\n    setErrores({})\r\n    setFallo(null)\r\n    onCancel()\r\n  }\r\n\r\n  return (\r\n    <section aria-labelledby=\"titulo-nuevo-metodo\">\r\n      <Card className={styles.panel}>      <div className={styles.header}>\r\n        <Subtitle1 as=\"h2\" id=\"titulo-nuevo-metodo\" className={styles.title}>\r\n          Datos del método de pago\r\n        </Subtitle1>\r\n        <Text className={styles.muted}>Se guardan cifrados.</Text>\r\n      </div>\r\n\r\n        {fallo && (\r\n          <MessageBar intent=\"error\">\r\n            <MessageBarBody>{fallo}</MessageBarBody>\r\n          </MessageBar>\r\n        )}\r\n\r\n        <fieldset className={styles.types}>\r\n          <legend>Tipo de método de pago</legend>\r\n          {TIPOS.map(({ valor, etiqueta, Icono }) => (\r\n            <ToggleButton\r\n              key={valor}\r\n              className={styles.type}\r\n              icon={<Icono />}\r\n              checked={tipo === valor}\r\n              onClick={() => setTipo(valor)}\r\n            >\r\n              {etiqueta}\r\n            </ToggleButton>\r\n          ))}\r\n        </fieldset>\r\n\r\n        {tipo === 'TARJETA' && (\r\n          <div className={styles.fields}>\r\n            <Field label=\"Número de tarjeta\" {...error('numeroTarjeta')}>\r\n              <Input\r\n                {...campo('numeroTarjeta')}\r\n                contentBefore={<Payment20Regular />}\r\n                placeholder=\"0000 0000 0000 0000\"\r\n                inputMode=\"numeric\"\r\n                maxLength={23}\r\n                autoComplete=\"cc-number\"\r\n              />\r\n            </Field>\r\n            <div className={styles.twoColumns}>\r\n              <Field label=\"Caducidad\" {...error('caducidad')}>\r\n                <Input\r\n                  {...campo('caducidad')}\r\n                  className={styles.shrinkable}\r\n                  contentBefore={<Calendar20Regular />}\r\n                  placeholder=\"MM/AA\"\r\n                  inputMode=\"numeric\"\r\n                  maxLength={5}\r\n                  autoComplete=\"cc-exp\"\r\n                />\r\n              </Field>\r\n              <Field label=\"CVV\" {...error('cvv')}>\r\n                <Input\r\n                  {...campo('cvv')}\r\n                  className={styles.shrinkable}\r\n                  contentBefore={<LockClosed20Regular />}\r\n                  type=\"password\"\r\n                  placeholder=\"123\"\r\n                  inputMode=\"numeric\"\r\n                  maxLength={4}\r\n                  autoComplete=\"cc-csc\"\r\n                />\r\n              </Field>\r\n            </div>\r\n            <Field label=\"Titular\" {...error('titular')}>\r\n              <Input {...campo('titular')} placeholder=\"Nombre y apellidos\" autoComplete=\"cc-name\" />\r\n            </Field>\r\n          </div>\r\n        )}\r\n\r\n        {tipo === 'PAYPAL' && (\r\n          <Field label=\"URL de PayPal\" {...error('urlPayPal')}>\r\n            <Input {...campo('urlPayPal')} contentBefore={<Globe20Regular />} type=\"url\" placeholder=\"https://paypal.me/tu-cuenta\" />\r\n          </Field>\r\n        )}\r\n\r\n        {tipo === 'BIZUM' && (\r\n          <Field label=\"Teléfono de Bizum\" {...error('telefonoBizum')}>\r\n            <Input {...campo('telefonoBizum')} contentBefore={<Phone20Regular />} type=\"tel\" inputMode=\"numeric\" maxLength={9} placeholder=\"600000000\" autoComplete=\"tel-national\" />\r\n          </Field>\r\n        )}\r\n\r\n        <div className={styles.actions}>\r\n          <Button appearance=\"primary\" onClick={guardar}>\r\n            Guardar método de pago\r\n          </Button>\r\n          <Button appearance=\"subtle\" onClick={cancelar}>\r\n            Cancelar\r\n          </Button>\r\n        </div>\r\n\r\n        <Text size={200} className={styles.secure}>\r\n          <LockClosed16Regular aria-hidden />\r\n          Tus datos de pago se guardan cifrados. El CVV no se guarda.\r\n        </Text>\r\n      </Card>\r\n    </section>\r\n  )\r\n}\r\n\r\nAddPaymentMethodPanel.propTypes = {\r\n  onSaved: PropTypes.func.isRequired,\r\n  onCancel: PropTypes.func.isRequired,\r\n}\r\n"],"file":"/frontend/src/features/paymentMethods/AddPaymentMethodPanel.jsx"}