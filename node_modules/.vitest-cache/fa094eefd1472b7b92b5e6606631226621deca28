uario…\" />}\r\n\r\n            {usuario && (\r\n              <EditableProfile\r\n                rol={usuario.rol}\r\n                usuario={usuario}\r\n                save={(datos) => updateUser(usuario.id, datos)}\r\n                onSaved={onSaved}\r\n                onCancel={onClose}\r\n              />\r\n            )}\r\n          </DialogContent>\r\n        </DialogBody>\r\n      </DialogSurface>\r\n    </Dialog>\r\n  )\r\n}\r\n\r\nUserEditDialog.propTypes = {\r\n  userId: PropTypes.string.isRequired,\r\n  onClose: PropTypes.func.isRequired,\r\n  onSaved: PropTypes.func.isRequired,\r\n}\r\n"],"file":"/frontend/src/features/admin/UserEditDialog.jsx"}